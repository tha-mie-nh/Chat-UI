PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key_here
INTERNAL_API_KEY=your_internal_api_key_here

MONGODB_URL=mongodb://admin:password@localhost:27017/chatbot?authSource=admin

AGENT_URL=http://your-agent-url

# Local file storage — ảnh lưu vào UPLOADS_DIR, serve qua /uploads/* endpoint
UPLOADS_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:3001

